    "mDNS" : {
      "shouldTranslate" : false
    },
    "macOS is preventing Network Scanner from reaching devices on your network. Allow it in System Settings › Privacy & Security › Local Network, then scan again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS verhindert, dass Network Scanner Geräte in deinem Netzwerk erreicht. Erlaube den Zugriff in Systemeinstellungen › Datenschutz & Sicherheit › Lokales Netzwerk und scanne dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS está impidiendo que Network Scanner acceda a los dispositivos de tu red. Permítelo en Ajustes del Sistema › Privacidad y seguridad › Red local y vuelve a escanear."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS está impidiendo que Network Scanner acceda a los dispositivos de tu red. Permítelo en Configuración del Sistema › Privacidad y seguridad › Red local y vuelve a escanear."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS empêche Network Scanner d’accéder aux appareils de votre réseau. Autorisez-le dans Réglages Système › Confidentialité et sécurité › Réseau local, puis relancez l’analyse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS impedisce a Network Scanner di raggiungere i dispositivi della tua rete. Consenti l’accesso in Impostazioni di Sistema › Privacy e sicurezza › Rete locale, poi esegui di nuovo la scansione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSによりNetwork Scannerがネットワーク上のデバイスにアクセスできません。「システム設定」›「プライバシーとセキュリティ」›「ローカルネットワーク」で許可してから、もう一度スキャンしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS está impedindo que o Network Scanner acesse os dispositivos da sua rede. Permita em Ajustes do Sistema › Privacidade e Segurança › Rede Local e verifique novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 正在阻止 Network Scanner 访问你网络中的设备。请在“系统设置”›“隐私与安全性”›“本地网络”中允许访问，然后再次扫描。"
          }
        }
      }
    },
    "macOS shows network addresses (BSSIDs) and the name of the network you're on only to apps with Location access. Network Scanner doesn't use or keep your location." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS zeigt Netzwerkadressen (BSSIDs) und den Namen des Netzwerks, mit dem du verbunden bist, nur Apps mit Zugriff auf den Standort. Network Scanner verwendet oder speichert deinen Standort nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS solo muestra las direcciones de red (BSSID) y el nombre de la red a la que estás conectado a las apps con acceso a la ubicación. Network Scanner no usa ni guarda tu ubicación."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS solo muestra las direcciones de red (BSSID) y el nombre de la red a la que estás conectado a las apps con acceso a la ubicación. Network Scanner no usa ni guarda tu ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ne montre les adresses réseau (BSSID) et le nom du réseau auquel vous êtes connecté qu’aux apps ayant accès à la localisation. Network Scanner n’utilise ni ne conserve votre position."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS mostra gli indirizzi di rete (BSSID) e il nome della rete a cui sei connesso solo alle app con accesso alla posizione. Network Scanner non usa né conserva la tua posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSは、ネットワークアドレス（BSSID）と接続中のネットワーク名を、位置情報へのアクセスを持つAppにのみ表示します。Network Scannerが位置情報を使用または保存することはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS mostra os endereços de rede (BSSIDs) e o nome da rede à qual você está conectado somente aos apps com acesso à localização. O Network Scanner não usa nem guarda sua localização."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 仅向拥有位置访问权限的 App 显示网络地址（BSSID）和你所连接网络的名称。Network Scanner 不会使用或保存你的位置。"
          }
        }
      }
    },
