    "Network Scanner" : {
      "shouldTranslate" : false
    },
    "Network Scanner sends ICMP, TCP, UDP and multicast DNS probes only to the addresses you choose. Scan networks you own or are authorized to test." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Network Scanner sendet ICMP-, TCP-, UDP- und Multicast-DNS-Anfragen nur an die Adressen, die du auswählst. Scanne nur Netzwerke, die dir gehören oder die du testen darfst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Network Scanner envía sondeos ICMP, TCP, UDP y DNS multicast solo a las direcciones que elijas. Escanea solo redes que sean tuyas o que tengas autorización para analizar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Network Scanner envía sondeos ICMP, TCP, UDP y DNS multicast solo a las direcciones que elijas. Escanea solo redes que sean tuyas o que tengas autorización para analizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Network Scanner envoie des sondes ICMP, TCP, UDP et DNS multicast uniquement aux adresses que vous choisissez. Analysez uniquement des réseaux qui vous appartiennent ou que vous êtes autorisé à tester."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Network Scanner invia sondaggi ICMP, TCP, UDP e DNS multicast solo agli indirizzi che scegli. Scansiona solo reti di tua proprietà o che sei autorizzato a testare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Network Scannerは、選択したアドレスにのみICMP、TCP、UDP、マルチキャストDNSのプローブを送信します。自分が所有している、またはテストを許可されているネットワークのみをスキャンしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Network Scanner envia sondagens ICMP, TCP, UDP e DNS multicast somente para os endereços que você escolher. Verifique apenas redes que sejam suas ou que você tenha autorização para testar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Network Scanner 仅向你选择的地址发送 ICMP、TCP、UDP 和多播 DNS 探测。请只扫描你拥有或获准测试的网络。"
          }
        }
      }
    },
