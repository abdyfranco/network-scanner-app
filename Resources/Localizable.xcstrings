    "The wake signal was sent, but the device hasn't answered yet. If it stays asleep, turn on Wake for network access (Mac) or Wake-on-LAN (PC) on it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Wecksignal wurde gesendet, aber das Gerät hat noch nicht geantwortet. Wenn es im Ruhezustand bleibt, aktiviere darauf „Ruhezustand bei Netzwerkzugriff beenden“ (Mac) bzw. Wake-on-LAN (PC)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envió la señal Wake-on-LAN, pero el dispositivo aún no responde. Si sigue en reposo, activa “Activar el ordenador para permitir el acceso a la red” (Mac) o Wake-on-LAN (PC) en él."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envió la señal Wake-on-LAN, pero el dispositivo aún no responde. Si sigue en reposo, activa “Activar la computadora para permitir el acceso a la red” (Mac) o Wake-on-LAN (PC) en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le signal de réveil a été envoyé, mais l’appareil n’a pas encore répondu. S’il reste en veille, activez « Réactiver lors des accès réseau » (Mac) ou Wake-on-LAN (PC) sur celui-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il segnale di riattivazione è stato inviato, ma il dispositivo non ha ancora risposto. Se resta in stop, attiva “Attiva per l’accesso alla rete” (Mac) o Wake-on-LAN (PC) sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープ解除の信号を送信しましたが、デバイスからまだ応答がありません。スリープのままの場合は、そのデバイスで「ネットワークアクセスによるスリープ解除」（Mac）またはWake-on-LAN（PC）をオンにしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sinal para despertar foi enviado, mas o dispositivo ainda não respondeu. Se ele continuar em repouso, ative “Despertar para o acesso de rede” (Mac) ou Wake-on-LAN (PC) nele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "唤醒信号已发送，但设备尚未响应。如果它仍处于睡眠状态，请在该设备上打开“唤醒以供网络访问”（Mac）或网络唤醒（PC）。"
          }
        }
      }
    },
