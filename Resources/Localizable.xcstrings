    "Couldn't send the wake signal. Check that Network Scanner has Local Network access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Wecksignal konnte nicht gesendet werden. Prüfe, ob Network Scanner auf das lokale Netzwerk zugreifen darf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo enviar la señal Wake-on-LAN. Comprueba que Network Scanner tenga acceso a la red local."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo enviar la señal Wake-on-LAN. Verifica que Network Scanner tenga acceso a la red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’envoyer le signal de réveil. Vérifiez que Network Scanner a accès au réseau local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile inviare il segnale di riattivazione. Verifica che Network Scanner abbia accesso alla rete locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープ解除の信号を送信できませんでした。Network Scannerにローカルネットワークへのアクセスが許可されているか確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível enviar o sinal para despertar. Verifique se o Network Scanner tem acesso à rede local."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法发送唤醒信号。请检查 Network Scanner 是否拥有本地网络访问权限。"
